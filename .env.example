# ==============================================================================
# SceneOS — Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local for local development.
# 
# SECURITY WARNING:
# - NEVER commit .env or .env.local containing real credentials.
# - NEVER expose SUPABASE_SERVICE_ROLE_KEY or GEMINI_API_KEY to Vite (no VITE_ prefix).
# - Only public/anon variables (prefixed with VITE_) are bundled into client code.
# ==============================================================================

# Data Provider Mode:
# Options: 'mock' (default offline mode) | 'supabase' (live backend)
VITE_DATA_PROVIDER=mock

# Supabase Public Configuration (Required only when VITE_DATA_PROVIDER=supabase):
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# Application Configuration:
VITE_APP_ENV=development
VITE_APP_VERSION=0.2.0
